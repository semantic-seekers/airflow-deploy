# Airflow Environment Configuration
# Generated by Ansible template

# Core Airflow settings
AIRFLOW_UID={{ airflow_uid }}
AIRFLOW_PROJ_DIR={{ airflow_project_dir }}
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5

# Security settings
AIRFLOW_FERNET_KEY={{ airflow_fernet_key | default('') }}

# Database configuration
POSTGRES_USER={{ postgres_user | default('airflow') }}
POSTGRES_PASSWORD={{ postgres_password | default('airflow') }}
POSTGRES_DB={{ postgres_db | default('airflow') }}

# Admin user configuration
_AIRFLOW_WWW_USER_USERNAME={{ airflow_admin_username | default('airflow') }}
_AIRFLOW_WWW_USER_PASSWORD={{ airflow_admin_password | default('airflow') }}

# Additional Airflow configuration
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW__WEBSERVER__RBAC=True
